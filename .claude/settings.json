{
  "permissions": {
    "allow": [
      "Bash",
      "PowerShell",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "WebFetch",
      "WebSearch",
      "Write",
      "mcp__plugin_hive-channel_hive__*",
      "Skill(fast-track-plan)"
    ],
    "additionalDirectories": [
      "C:/Projects/webstorm/orbital",
      "C:/Projects/TendWright"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"export HIVE_AGENT_KEY=spark && bash C:/Projects/wfa2/hooks/hive-status-working.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"export HIVE_AGENT_KEY=spark && bash C:/Projects/wfa2/hooks/hive-status-idle.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "autoMemoryDirectory": ".claude/memory"
}
