{
  "permissions": {
    "allow": [
      "Bash",
      "PowerShell",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "WebFetch",
      "WebSearch",
      "Write",
      "mcp__plugin_hive-channel_hive__*",
      "Skill(fast-track-plan)",
      "Bash(git -C C:/Projects/TendWright branch -d:*)",
      "Bash(git -C C:/Projects/TendWright push origin --delete:*)",
      "Bash(git -C C:/Projects/TendWright worktree list)",
      "Bash(git -C C:/Projects/TendWright worktree prune)",
      "Bash(git -C C:/Projects/webstorm/orbital branch -d:*)",
      "Bash(git -C C:/Projects/webstorm/orbital push origin --delete:*)",
      "Bash(git -C C:/Projects/webstorm/orbital worktree list)",
      "Bash(git -C C:/Projects/webstorm/orbital worktree prune)",
      "Bash(git -C C:/Projects/TendWright worktree remove C:/Projects/grok-worktrees/*)",
      "Bash(git -C C:/Projects/TendWright worktree remove --force C:/Projects/grok-worktrees/*)",
      "Bash(git -C C:/Projects/webstorm/orbital worktree remove C:/Projects/grok-worktrees/*)",
      "Bash(git -C C:/Projects/webstorm/orbital worktree remove --force C:/Projects/grok-worktrees/*)"
    ],
    "additionalDirectories": [
      "C:/Projects/webstorm/orbital",
      "C:/Projects/TendWright"
    ],
    "deny": [
      "Bash(git * worktree remove *..*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Projects/wfa2/hooks/hive-status-working.mjs --agent spark",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Projects/wfa2/hooks/jev-prompt-router.mjs --agent spark",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node C:/Projects/wfa2/hooks/jev-intake.mjs --agent spark",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Projects/wfa2/hooks/hive-status-idle.mjs --agent spark",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Projects/wfa2/hooks/jev-stop-gate.mjs --agent spark",
            "timeout": 25
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Projects/wfa2/hooks/memory-origin-guard.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Projects/wfa2/hooks/hive-context-snapshot.mjs --agent spark",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Projects/wfa2/hooks/hive-subagent-stop.mjs --agent spark",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Projects/wfa2/hooks/kill-guard.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plugin_hive-channel_hive__hive_plan_update",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Projects/wfa2/hooks/jev-readiness-gate.mjs --agent spark",
            "timeout": 90
          }
        ]
      }
    ]
  },
  "autoMemoryDirectory": "C:/Projects/spark/.claude/memory"
}
